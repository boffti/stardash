# ============================================================
# StarDash Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ------------------------------------------------------------
# Database (SQLite file; the directory is created on first run)
# ------------------------------------------------------------
DATABASE_PATH=./data/stardash.db

# ------------------------------------------------------------
# AI (optional — users can supply their own key in Settings)
# OpenRouter gives access to Gemini, GPT-4o, Claude, and more
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...

# ------------------------------------------------------------
# Cron security (only needed if an external scheduler calls /api/cron/*)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------
# Optional GitHub PAT for background jobs. Defaults to the signed-in owner's token.
# ------------------------------------------------------------
GITHUB_PAT=

# Radar feed (off until the radar migration is applied)
NEXT_PUBLIC_RADAR_ENABLED=false

# ------------------------------------------------------------
# Sentry — error tracking (optional)
# From: sentry.io → Project → Settings → Client Keys
# ------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------
# Langfuse — AI observability (optional)
# From: cloud.langfuse.com → Project → Settings → API Keys
# NOTE: Always pass LANGFUSE_BASE_URL explicitly when creating
# Langfuse clients — the SDK defaults to LANGFUSE_BASEURL (no underscore)
# ------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
